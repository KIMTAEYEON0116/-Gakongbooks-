# ── 가공독서회 환경변수 템플릿 ──
# 이 파일을 복사해 .env로 만들고 값을 채우세요. (.env는 절대 커밋하지 않습니다)
# 대부분의 값은 config.py에서 읽습니다. (예외: DATABASE_URL은 database.py, GEMINI_API_KEY는 main.py가 직접 읽습니다)

# 실행 환경: development | production
# production으로 두면 필수 시크릿이 비어 있을 때 서버가 기동되지 않고,
# API 문서(/docs)도 노출되지 않으며 HSTS 헤더가 부착됩니다.
APP_ENV=development

# ── 데이터베이스 ──
DATABASE_URL=mysql+pymysql://아이디:비밀번호@localhost:3306/gakong_db

# ── JWT 인증 (필수) ──
# 이 값을 아는 사람은 누구나 로그인 토큰을 위조할 수 있으므로 충분히 긴 난수를 쓰세요.
#   생성 예:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 운영자 계정 ──
# 이 서비스의 유일한 운영자(사람). 기동 시 이 계정에만 관리자 권한이 부여되고,
# 다른 계정에 남아 있는 관리자 권한은 자동으로 회수됩니다.
OWNER_ADMIN_EMAIL=

# ── AI 사회자(봇) 계정 ──
# 최초 기동 시 생성되는 AI 사회자 봇 계정의 이메일입니다.
# 봇은 로그인이 차단되어 있어 비밀번호를 설정할 필요가 없습니다(서버가 난수를 넣습니다).
ADMIN_SEED_EMAIL=admin@admin.com

# ── CORS ──
# 다른 도메인에서 이 API를 호출해야 할 때만 쉼표로 나열합니다. 와일드카드(*)는 금지됩니다.
# 개발 환경에서는 localhost의 모든 포트가 자동 허용되므로 비워두면 됩니다.
ALLOW_ORIGINS=

# ── 비밀번호 재설정 링크 ──
# 메일에 들어갈 링크의 기준 주소. 운영 도메인으로 반드시 교체하세요.
APP_BASE_URL=http://127.0.0.1:8001
PASSWORD_RESET_TTL_MINUTES=30

# ── Google SMTP (비밀번호 재설정 메일 발송용) ──
# Gmail은 2단계 인증 활성화 후 '앱 비밀번호'를 발급해 SMTP_PASSWORD에 넣어야 합니다.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── 외부 API ──
GEMINI_API_KEY=

# ── 리버스 프록시 (운영) ──
# 프록시(Nginx, Cloudflare 등) 뒤에서 운영할 때 그 프록시의 IP를 쉼표로 나열합니다.
# 여기 적힌 IP에서 온 요청만 X-Forwarded-For 헤더를 클라이언트 IP로 인정합니다.
# 비워 두면 헤더를 무시하므로, 프록시 뒤에서는 반드시 지정해야 IP 기준 레이트리밋이 동작합니다.
TRUSTED_PROXY_IPS=127.0.0.1
